/target

# Wrangler local secrets and state (the stack targets Cloudflare Workers;
# .dev.vars must never be committed)
.dev.vars
.dev.vars.*
!.dev.vars.example
/.wrangler/

# Local tooling and editor state (never part of the repo)
/.claude/
/.codex/
/.devcontainer/
/.idea/
/.vscode/
/.mcp.json

# Stray run logs (never part of the repo)
*.log
